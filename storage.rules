rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to verify user authentication & ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Gallery images scoped strictly to user ID folder (/gallery/{userId}/{fileName})
    // Enforces maximum file size limit of 10MB per image
    match /gallery/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }

    // Audio voice notes scoped strictly to user ID folder (/audio/{userId}/{fileName})
    // Enforces maximum file size limit of 25MB per audio note
    match /audio/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && request.resource.size < 25 * 1024 * 1024;
    }

    // Fallback: deny read/write to all unmapped storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
